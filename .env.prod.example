# Copy this file to .env.prod and update all values before production deployment.

# Database
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=tucdrive
MYSQL_USER=tucdrive_user
MYSQL_PASSWORD=replace_with_strong_app_password

# Backend security
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Comma-separated list of allowed browser origins for API CORS
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80
